{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "*": ["src/@types/*"]
    },
    "types": ["@types/node", "@figma/plugin-typings"]
  },
  "include": ["src", "eslint.config.js", "vite.config.ts", "vite.config.code.ts"],
  "exclude": ["node_modules", "dist", "src/ui/assets/types"]
}
